# Copy to .env.local and adjust if the backend API is not on the default address or uses another key.
POKEMON_API_URL=http://localhost:8080/api/v1
# Must match the backend's pokemonlb.api-key (POKEMON_API_KEY there). Never prefix it with NEXT_PUBLIC_:
# that would ship the key to the browser.
POKEMON_API_KEY=pokemonlb-dev-key
