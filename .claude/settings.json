{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/graphify-update.sh\" >/dev/null 2>&1 || true",
            "async": true,
            "timeout": 120,
            "statusMessage": "Updating graphify code graph"
          }
        ]
      }
    ]
  }
}
